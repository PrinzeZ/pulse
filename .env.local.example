# P.U.L.S.E local environment template
# Copy this file to .env.local and replace placeholders with real values.
# NEVER commit .env.local.

SPRING_DATASOURCE_PASSWORD=
PULSE_CARTO_MAP_KEY=
PULSE_LAN_IP=
PULSE_LAN_REGISTRATION_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_SECRET_USED_ON_RAILWAY
PULSE_SESSION_COOKIE_SECURE=false
# Audit archives: 32-byte AES key encoded as Base64. Keep identical on the hospital and cloud instances.
# Generate with: .\scripts\generate-audit-key.ps1
# If left blank, P.U.L.S.E derives the audit key from the shared LAN registration secret automatically.
PULSE_AUDIT_ARCHIVE_KEY_BASE64=
# Optional daily audit notification recipient.
PULSE_AUDIT_ADMIN_EMAIL=
